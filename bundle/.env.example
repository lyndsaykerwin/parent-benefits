# Copy this file to .env (cp .env.example .env) and fill in values on YOUR computer only.
# This file holds setting NAMES and placeholders. Never put a real key, token or password in it,
# and never commit your real .env (it is git-ignored).
# "Environment variable" = a named setting the app reads when it starts.
# With SAMPLE_MODE=true nothing below needs a real value: the app runs from saved sample data.
# Defaults in [brackets] are what the code uses when a setting is left empty.

# ---------- Core ----------
# true = run from saved sample families + saved Zetaris answers (data/sample/zetaris-cache), no keys needed.
SAMPLE_MODE=true
# Which door number (port) the app listens on. [5050]
PORT=5050
# Demo date for the sample families, format YYYY-MM-DD. [2026-10-23]
TODAY=""
# Trust the web host's forwarding header so each visitor gets their own rate limit.
# On by default when NODE_ENV=production (npm start sets that). 0 = off, 1 = force on.
TRUST_PROXY=""
# Reviewer mode password (lets a judge approve a proposed rule). Empty = Reviewer mode off.
REVIEWER_MODE_TOKEN="<choose-a-long-random-phrase>"
# Web address of the front end, only if it is hosted separately from the server.
FRONTEND_URL=""
# The app's public web address on a host, e.g. https://bundle-xxxx.onrender.com (allowed to call the server).
# On Render this is optional: Render fills in RENDER_EXTERNAL_URL by itself and the app uses that too.
PUBLIC_URL=""
# Tester entry code: when filled in, every phone must type this code once before using the app (web host only).
# Leave EMPTY on your own computer = no gate. Pick something easy to read aloud, e.g. "blue-otter-42".
TESTER_ACCESS_CODE=""
# 1/true = also print the agent log to the terminal. false = never.
AGENT_LOG_STDOUT=""

# ---------- Live mode only (SAMPLE_MODE=false, or recording on the Mac) ----------
# Neon = the online Postgres database holding families, offers and rules.
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require"
# Zetaris = the SQL "data door" that reads our scattered sources.
ZETARIS_BASE_URL="https://<your-zetaris-host>"
ZETARIS_ORG_ID="<your-zetaris-org-id>"
ZETARIS_API_KEY="<your-zetaris-api-key>"
# How long to wait for one outside source (seconds) and how many times to retry. [20] [2]
SOURCE_TIMEOUT_SECONDS=20
MAX_RETRIES=2

# ---------- AI: NVIDIA direct (the backup route; works from any computer with the key) ----------
# Empty key = no direct NVIDIA calls. If Nightshift is also unavailable, the app uses saved offline text.
MODEL_API_KEY="<nvapi-your-nvidia-key>"
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
# Exact model names, picked on build.nvidia.com (or `npm run model:check -- --provider nvidia --write`).
MODEL_REASONING="<nvidia-model-id-for-hard-questions>"
MODEL_FAST="<nvidia-model-id-for-quick-questions>"
MODEL_JUDGE="<optional-model-id-for-the-court-judge>"
# Photo-reading models. [nvidia/nemotron-3-nano-omni-30b-a3b-reasoning]. Receipt falls back to MODEL_VISION.
MODEL_VISION=""
MODEL_VISION_RECEIPT=""

# ---------- AI: which route, and how it behaves ----------
# auto = Nightshift first, then NVIDIA direct, then saved offline text. Or: nightshift | nvidia | offline. [auto]
MODEL_PROVIDER=""
# "Thinking out loud" before answering, for NVIDIA direct: off | low | on. [off]
MODEL_THINKING=""
# Longest reply the AI may write, in "tokens" (small chunks of words). [4096]
MODEL_MAX_TOKENS=""
# Give up on one NVIDIA call after this many seconds. [90]
MODEL_TIMEOUT_SECONDS=""
# true = in sample mode, still ask the real AI (used by eval:live-model and Mac demos).
LIVE_MODEL=""
# Whole-run time limit in seconds; after it, remaining AI steps use saved offline text. [300]
RUN_DEADLINE_SECONDS=""

# ---------- Nightshift (Meterless's AI switchboard; runs only on Lyndsay's Mac) ----------
# Address of Nightshift on this same computer. [http://127.0.0.1:8088/v1]
NIGHTSHIFT_BASE_URL=""
# Its password. Prefer the file route: put the PATH to the token file here, never the token itself.
NIGHTSHIFT_TOKEN_FILE="<path-to-nightshift-token-file>"
# Alternative to the file (less safe). Leave empty if you use the file.
NIGHTSHIFT_TOKEN=""
# Model names sent to Nightshift. [meterless/text.deep] and [meterless/text.fast]
# After Meterless's Sunday Oct 25 update, set REASONING to the exact Nemotron name that
# `npm run model:check -- --provider nightshift` prints (docs/mac-flip-on-checklist.md, step 10).
NIGHTSHIFT_REASONING=""
NIGHTSHIFT_FAST=""
NIGHTSHIFT_JUDGE=""
# Give up on one Nightshift call after this many seconds. Raise it for the big model. [180]
NIGHTSHIFT_TIMEOUT_SECONDS=""
# Extra JSON added to every Nightshift request, e.g. the "thinking off" switch (one line, a JSON object).
# The exact field name comes from Nightshift's Sunday update; do not guess it.
NIGHTSHIFT_EXTRA_BODY=""

# ---------- "Is it worth your time" scoring (all optional; built-in defaults) ----------
WORTH_EFFORT_VALUE_CENTS=""
WORTH_MAX_EFFORT_MINUTES=""
WORTH_MAX_PAYOUT_DAYS=""
WORTH_MIN_VALUE_CENTS=""
EFFORT_BASE_MINUTES=""
EFFORT_IN_STORE_MINUTES=""
EFFORT_MAIL_IN_MINUTES=""
EFFORT_PER_STEP_MINUTES=""
EFFORT_PHONE_CALL_MINUTES=""

# ---------- Throwaway local test database (npm run db:test), never the real one ----------
# TEST_DATABASE_URL="postgres://bundle:bundle@127.0.0.1:5432/bundle_test"
# RUN_DB_TESTS=""
