+      cand('benefit-pfml', 'benefit', 'benefits', { deadline: '2027-10-03' }),
+      cand('clawback-1', 'clawback', 'clawback', { amountCents: 5000 }),
+      cand('clawback-2', 'clawback', 'clawback', { amountCents: 700, verdict: 'blocked' }),
