# Copy to .env (cp .env.example .env). Placeholders only. Never commit real values.
# With SAMPLE_MODE=true nothing below needs a real value: the app runs from saved sample data.

# Run with no keys: families from data/sample/families.json, Zetaris answered from
# data/sample/zetaris-cache (saved real responses), offline text when MODEL_API_KEY is empty.
SAMPLE_MODE=true

PORT=5050

# --- Live mode only (SAMPLE_MODE=false) ---
# Neon Postgres (where families, offers and benefit rules live)
# DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require"

# Zetaris (the SQL "data door")
ZETARIS_BASE_URL=""
ZETARIS_ORG_ID=""
ZETARIS_API_KEY=""

# AI model (NVIDIA-hosted, OpenAI-compatible). Empty = the app uses offline fallback text.
MODEL_API_KEY=""
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
# Model ids: pick on build.nvidia.com. Left empty on purpose; the app still runs.
MODEL_REASONING=""
MODEL_FAST=""

SOURCE_TIMEOUT_SECONDS=20
MAX_RETRIES=2

# Reviewer mode token (lets a judge approve a proposed rule). Empty = Reviewer mode off.
REVIEWER_MODE_TOKEN=""

# Demo date for the sample families (defaults to 2026-10-23)
TODAY=""

# Trusting the hosting proxy (so each visitor gets their own rate limit) is on by default in production
# (NODE_ENV=production, which `npm start` sets). Set 0 to turn it off, or 1 to force it on.
TRUST_PROXY=""

# Optional (payments, not used right now)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- Added in waves 1-2 (names only; every one is optional and has a built-in default) ---
# Nightshift (the main text-model host). Token via NIGHTSHIFT_TOKEN or a file path in NIGHTSHIFT_TOKEN_FILE.
NIGHTSHIFT_BASE_URL=""
NIGHTSHIFT_TOKEN=""
NIGHTSHIFT_TOKEN_FILE=""
NIGHTSHIFT_REASONING=""
NIGHTSHIFT_FAST=""
NIGHTSHIFT_JUDGE=""
NIGHTSHIFT_TIMEOUT_SECONDS=""
NIGHTSHIFT_EXTRA_BODY=""
# Model settings
MODEL_PROVIDER=""            # auto | offline | one provider name
MODEL_JUDGE=""
MODEL_THINKING=""            # off | low | on
MODEL_MAX_TOKENS=""
MODEL_TIMEOUT_SECONDS=""
MODEL_VISION=""              # photo model (labels, cans)
MODEL_VISION_RECEIPT=""      # receipt photo model; empty = use MODEL_VISION
LIVE_MODEL=""
RUN_DEADLINE_SECONDS=""
# "Is it worth your time" scoring
WORTH_EFFORT_VALUE_CENTS=""
WORTH_MAX_EFFORT_MINUTES=""
WORTH_MAX_PAYOUT_DAYS=""
WORTH_MIN_VALUE_CENTS=""
EFFORT_BASE_MINUTES=""
EFFORT_IN_STORE_MINUTES=""
EFFORT_MAIL_IN_MINUTES=""
EFFORT_PER_STEP_MINUTES=""
EFFORT_PHONE_CALL_MINUTES=""
# Logging and tests
AGENT_LOG_STDOUT=""          # 1 = also print the agent log to the terminal
FRONTEND_URL=""
# Throwaway local test database (npm run db:test), never the real one
# TEST_DATABASE_URL="postgres://bundle:bundle@127.0.0.1:5432/bundle_test"
# RUN_DB_TESTS=""
